# ============================================================================
#  oci-w Nginx 反向代理示例
# ----------------------------------------------------------------------------
#  用途：给面板套上 HTTPS（强烈建议，避免账号与 OCI 密钥以明文 HTTP 传输），
#        并同时保留 VNC 救砖所需的 WebSocket 通道。
#
#  放置位置：
#    Debian/Ubuntu : /etc/nginx/conf.d/oci-w.conf
#    CentOS/RHEL   : /etc/nginx/conf.d/oci-w.conf
#    （宝塔/1Panel : 站点设置 → 配置文件，把下面 server 块内容并入）
#
#  证书：用 certbot 签发，或使用面板自带证书功能。
#    certbot --nginx -d panel.example.com
# ============================================================================

server {
    listen 80;
    server_name panel.example.com;      # ← 改成你的域名
    # 强制跳转 HTTPS（证书签发完成后再启用）
    # return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name panel.example.com;      # ← 改成你的域名

    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;

    # 面板上传备份文件可能较大，按需调整
    client_max_body_size 512m;

    # ------------------------------------------------------------------
    # VNC / Cloud Shell 救砖通道
    # 对应 docker-compose.yml 中 websockify 暴露的 127.0.0.1:6080
    # 两个 Upgrade/Connection 头缺一不可，否则 WebSocket 无法建立。
    # ------------------------------------------------------------------
    location /myvnc/ {
        proxy_pass http://127.0.0.1:6080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        # 终端会话可能长时间无数据，超时必须放大，否则几分钟就掉线
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }

    # ------------------------------------------------------------------
    # 面板主服务
    # 实时日志与 WebSSH 走 WebSocket，同样需要 Upgrade 头
    # ------------------------------------------------------------------
    location / {
        add_header Cache-Control no-cache;
        proxy_pass http://127.0.0.1:8818;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}

# ============================================================================
#  注意：
#  1) 若配置了本文件，请把 docker-compose.yml 中 oci-w 的端口绑定改为
#       "127.0.0.1:8818:8818"
#     这样外部无法用 IP+端口绕过 HTTPS 直连面板。
#  2) 防火墙只需放行 80/443，8818 与 6080 都不需要对公网开放。
#  3) 记得放行 Oracle 云侧安全列表中的 80/443（这是云侧第一层防火墙）。
# ============================================================================
